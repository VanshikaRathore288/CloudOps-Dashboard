# ─────────────────────────────────────────────────────────────────────────────
# CloudOps Dashboard — Environment Variable Template
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# NEVER commit .env.local or .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
# Base URL of the deployed application (used for Open Graph and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment: development | production | test
NODE_ENV=development

# ── AWS (required only for live infrastructure integration) ───────────────────
# IMPORTANT: Do not use long-lived IAM access keys in production.
# Prefer EC2 instance profiles (IAM roles) so no credentials are stored at all.
#
# These are only needed locally if you integrate AWS SDK calls.
# Leave blank if the dashboard is using sample data only.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=REPLACE_WITH_YOUR_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_YOUR_SECRET

# S3 bucket name for static assets (if CloudFront + S3 integration is enabled)
AWS_S3_BUCKET=your-s3-bucket-name

# CloudFront distribution ID (for cache invalidation on deployment)
AWS_CLOUDFRONT_DISTRIBUTION_ID=REPLACE_WITH_DISTRIBUTION_ID

# ── Monitoring (optional) ──────────────────────────────────────────────────────
# If you integrate UptimeRobot or a similar service, add the read-only API key.
# UPTIME_ROBOT_API_KEY=REPLACE_WITH_KEY

# ── Docker Hub (set as GitHub Actions secrets, not here) ──────────────────────
# DOCKER_USERNAME  — set in GitHub repo → Settings → Secrets and variables
# DOCKER_PASSWORD  — set in GitHub repo → Settings → Secrets and variables
